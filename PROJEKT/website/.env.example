# Website-Server. .env bleibt privat und von Git ausgeschlossen.
MISCHWERK_APPLICATIONS_ENABLED=false
MISCHWERK_APPLICATION_TO=
MISCHWERK_SMTP_HOST=smtp.mailbox.org
MISCHWERK_SMTP_PORT=465
MISCHWERK_SMTP_USER=
MISCHWERK_SMTP_FROM=
MISCHWERK_SMTP_PASSWORD=
# Vollständige URL aus dem ownergeprüften Appbefehl /mischwerk-web
MISCHWERK_APP_WEBHOOK=

# Für Hosting hinter HTTPS-Proxy auf den exakten öffentlichen Ursprung ohne Schluss-Slash setzen.
MISCHWERK_PUBLIC_ORIGIN=
# Lokaler Start; im Hosting gegebenenfalls durch PORT vorgegeben.
MISCHWERK_PREVIEW_PORT=8766
MISCHWERK_BIND_ADDRESS=127.0.0.1
