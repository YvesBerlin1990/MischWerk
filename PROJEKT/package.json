{
  "name": "mischwerk-knuddels-userapp",
  "version": "0.1.26",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "MischWerk MyChannel Radio für Otterchen – Knuddels UserApps / K3",
  "scripts": {
    "build:backend": "node tools/build-backend.cjs",
    "check:backend": "node tools/build-backend.cjs --check",
